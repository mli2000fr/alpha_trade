# Exemple de fichier .env pour le watcher Windows Alpha Trade
# Copier ce fichier vers `scripts/windows/protection_watcher.env` ou fournir -EnvFilePath.
LOGIN_DB=mon_user_mysql
PASSWORD_DB=mon_mot_de_passe_mysql
ALPACA_API_KEY=ma_cle_api_alpaca
ALPACA_SECRET_KEY=mon_secret_alpaca
# Si vous utilisez un montage multi-comptes Alpaca, vous pouvez aussi ajouter :
# ALPACA_PAPER_1_API_KEY=...
# ALPACA_PAPER_1_SECRET_KEY=...
# ALPACA_PAPER_1_MODE=paper
# ALPACA_PAPER_1_LABEL=Paper account 1
