# earnings_calendar.env.example
#
# Copier vers `earnings_calendar.env` (même dossier) pour que le launcher
# `earnings_calendar_launcher.ps1` charge ces variables avant d'exécuter la
# synchronisation — utile quand la tâche planifiée Windows ne reprend pas
# l'environnement de votre shell.
#
#   Copy-Item .\scripts\windows\earnings_calendar.env.example .\scripts\windows\earnings_calendar.env
#
# Si ces variables sont déjà définies comme variables d'environnement Windows
# (système ou utilisateur), ce fichier n'est pas nécessaire.

# Credentials de la base (lus par database/connection.py).
LOGIN_DB=your_db_login
PASSWORD_DB=your_db_password

# Optionnel — autres variables requises par votre environnement.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
